              {
                "color": "#E02F44",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(pricing_errors_total{application=\"epricing-service\",error_type=\"PRICING_CALCULATION_FAILED\"}[$__range])) or vector(0)",
          "legendFormat": "Calc Errors",
          "refId": "A"
        }
      ],
      "description": "**Technical Pricing Failures (`PRICING_CALCULATION_FAILED` in Time Window)**\n\nPrometheus counter increment (`pricing_errors_total{error_type=\"PRICING_CALCULATION_FAILED\"}`) over `$__range`.\n\n- **Triggers when:** An unexpected runtime/DB exception is wrapped into `PricingCalculationException` inside `PricingService.calculatePricing()`.\n- **Green:** Strictly `0` | **Red:** `≥ 1` (check *ERROR Logs — Live Stream* for full Java stack trace)."
    },
