    {
      "id": 41,
      "title": "All Error Types (Cumulative)",
      "description": "Cumulative count of pricing errors by error type",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (error_type) (pricing_errors_total{application=\"epricing-service\"})",
          "legendFormat": "{{error_type}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 42,
      "title": "Error Rate Over Time",
      "description": "Rate of pricing errors per second by error type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 7,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(pricing_errors_total{application=\"epricing-service\"}[1m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
