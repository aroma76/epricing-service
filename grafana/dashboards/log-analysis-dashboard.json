  "version": 11,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Log Volume Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "ERROR Log Count (last range)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-uid"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#9FC119",
                "value": null
              },
              {
                "color": "#E02F44",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({application=\"epricing-service\", level=\"ERROR\"}[$__range]))",
          "legendFormat": "ERROR logs",
          "refId": "A"
        }
      ],
      "description": "**Total `ERROR` Log Events in Selected Time Window (Loki)**\n\nCounts JSON log entries shipped by Promtail to Loki matching `{application=\"epricing-service\", level=\"ERROR\"}` over `$__range`.\n\n- **Green:** `0`\n- **Red:** `≥ 1` — Unhandled runtime exceptions, DB failures, or `/metrics-demo/simulate-error` events occurred; inspect *ERROR Logs — Live Stream* below."
    },
    {
