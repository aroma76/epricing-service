age recorded'\n    ELSE ''\n  END                                                                 AS \"Error Summary\",\n  COALESCE(error_message, '')                                         AS \"Full Error (DB)\",\n  trace_id                                                            AS \"Trace ID\"\nFROM pricing_requests\nORDER BY created_at DESC\nLIMIT 500",
