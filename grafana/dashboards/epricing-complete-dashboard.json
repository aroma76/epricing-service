              {
                "color": "#E02F44",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "pricing_requests_total{application=\"epricing-service\",type=\"failed\"}",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ],
      "description": "**Cumulative Technical Failures (`type=\"failed\"`)**\n\nCount of unexpected technical or runtime errors during pricing calculation (`PricingService.recordPricingFailure()`). Excludes business rule rejections (which increment `type=\"rejected\"` instead).\n\n- **Green:** `0` | **Red:** `≥ 1` — Inspect *ERROR Logs* and YugabyteDB `ERROR` rows immediately."
    },
