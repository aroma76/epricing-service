{
  "annotations": { "list": [] },
  "description": "ePricing Service — Complete Observability Dashboard. CRMNXT color scheme. Real Prometheus metrics + DB queries.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["epricing", "observability", "complete"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Kolkata",
  "title": "ePricing Complete Observability Dashboard",
  "uid": "epricing-complete",
  "version": 2,
  "panels": [

    { "id": 1, "type": "row", "title": "Service Health Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 2, "title": "Service Status",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "color": "#E02F44", "text": "DOWN" }, "1": { "color": "#9FC119", "text": "UP" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "#E02F44", "value": null }, { "color": "#9FC119", "value": 1 }] } } },
      "targets": [{ "expr": "up{job=\"epricing-service\"}", "legendFormat": "Service", "refId": "A" }]
    },

    {
      "id": 3, "title": "Total Requests (All Time)",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }] } } },
      "targets": [{ "expr": "pricing_requests_total{application=\"epricing-service\",type=\"all\"}", "legendFormat": "Total", "refId": "A" }]
    },

    {
      "id": 4, "title": "Successful Pricings",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }] } } },
      "targets": [{ "expr": "pricing_requests_total{application=\"epricing-service\",type=\"success\"}", "legendFormat": "Success", "refId": "A" }]
    },

    {
      "id": 5, "title": "Failed Pricings",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "#E02F44", "value": 1 }] } } },
      "targets": [{ "expr": "pricing_requests_total{application=\"epricing-service\",type=\"failed\"}", "legendFormat": "Failed", "refId": "A" }]
    },

    {
      "id": 6, "title": "Active In-Flight Requests",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "yellow", "value": 20 }, { "color": "#E02F44", "value": 50 }] } } },
      "targets": [{ "expr": "pricing_requests_active{application=\"epricing-service\"}", "legendFormat": "In-Flight", "refId": "A" }]
    },

    {
      "id": 7, "title": "CPU Utilization",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "yellow", "value": 50 }, { "color": "#E02F44", "value": 80 }] } } },
      "targets": [{ "expr": "process_cpu_usage{application=\"epricing-service\"} * 100", "legendFormat": "CPU %", "refId": "A" }]
    },

    {
      "id": 8, "title": "Heap Memory Used",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "yellow", "value": 60 }, { "color": "#E02F44", "value": 85 }] } } },
      "targets": [{ "expr": "jvm_memory_used_bytes{application=\"epricing-service\",area=\"heap\"} / jvm_memory_max_bytes{application=\"epricing-service\",area=\"heap\"} * 100", "legendFormat": "Heap %", "refId": "A" }]
    },

    {
      "id": 9, "title": "DB Pool Active",
      "type": "stat", "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "yellow", "value": 7 }, { "color": "#E02F44", "value": 10 }] } } },
      "targets": [{ "expr": "hikaricp_connections_active{application=\"epricing-service\",pool=\"epricing-pool\"}", "legendFormat": "Active", "refId": "A" }]
    },

    { "id": 10, "type": "row", "title": "Request Rate & Latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },

    {
      "id": 11, "title": "Request Rate (req/s)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"epricing-service\",outcome=\"SUCCESS\"}[1m]))", "legendFormat": "Success req/s", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"epricing-service\",outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[1m]))", "legendFormat": "Error req/s", "refId": "B" }
      ]
    },

    {
      "id": 12, "title": "Response Time Percentiles",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p99", "refId": "C" }
      ]
    },

    { "id": 20, "type": "row", "title": "Pricing Business Metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false },

    {
      "id": 21, "title": "Requests by Product Type",
      "type": "barchart", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "right" } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [{ "expr": "pricing_product_requests_total{application=\"epricing-service\"}", "legendFormat": "{{product}}", "refId": "A" }]
    },

    {
      "id": 22, "title": "Pricing Calculation Duration (p50/p95/p99 ms)",
      "type": "stat", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "yellow", "value": 100 }, { "color": "#E02F44", "value": 500 }] } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pricing_calculation_duration_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p50 calc ms", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(pricing_calculation_duration_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p95 calc ms", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(pricing_calculation_duration_seconds_bucket{application=\"epricing-service\"}[5m])) by (le)) * 1000", "legendFormat": "p99 calc ms", "refId": "C" }
      ]
    },

    { "id": 30, "type": "row", "title": "Error Analysis", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false },

    {
      "id": 31, "title": "5XX Errors by Type",
      "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "#E02F44", "value": 1 }] } } },
      "targets": [{ "expr": "sum by (error_type) (pricing_errors_total{application=\"epricing-service\"})", "legendFormat": "{{error_type}}", "refId": "A" }]
    },

    {
      "id": 32, "title": "4XX Errors (Client Errors)",
      "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["sum"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "#9FC119", "value": null }, { "color": "#E02F44", "value": 1 }] } } },
      "targets": [{ "expr": "sum(increase(http_server_requests_seconds_count{application=\"epricing-service\",status=~\"4..\"}[$__range])) or vector(0)", "legendFormat": "4XX Total", "refId": "A" }]
    },

    {
      "id": 33, "title": "Error Rate Over Time",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 15 } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"epricing-service\",status=~\"4..\"}[1m]))", "legendFormat": "4XX/s", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"epricing-service\",status=~\"5..\"}[1m]))", "legendFormat": "5XX/s", "refId": "B" }
      ]
    },

    { "id": 40, "type": "row", "title": "Database Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "collapsed": false },

    {
      "id": 41, "title": "HikariCP Connection Pool",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"epricing-service\",pool=\"epricing-pool\"}", "legendFormat": "Active", "refId": "A" },
        { "expr": "hikaricp_connections_idle{application=\"epricing-service\",pool=\"epricing-pool\"}", "legendFormat": "Idle", "refId": "B" },
        { "expr": "hikaricp_connections_pending{application=\"epricing-service\",pool=\"epricing-pool\"}", "legendFormat": "Pending", "refId": "C" },
        { "expr": "hikaricp_connections_max{application=\"epricing-service\",pool=\"epricing-pool\"}", "legendFormat": "Max Pool Size", "refId": "D" }
      ]
    },

    {
      "id": 42, "title": "DB Acquisition Time (ms)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket{application=\"epricing-service\",pool=\"epricing-pool\"}[5m])) by (le)) * 1000", "legendFormat": "p95 Acquire ms", "refId": "A" },
        { "expr": "hikaricp_connections_acquire_seconds_max{application=\"epricing-service\",pool=\"epricing-pool\"} * 1000", "legendFormat": "Max Acquire ms", "refId": "B" }
      ]
    },

    { "id": 50, "type": "row", "title": "JVM Runtime Metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "collapsed": false },

    {
      "id": 51, "title": "JVM Memory — Heap Used vs Max",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"epricing-service\",area=\"heap\"}", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "jvm_memory_max_bytes{application=\"epricing-service\",area=\"heap\"}", "legendFormat": "Heap Max", "refId": "B" }
      ]
    },

    {
      "id": 52, "title": "CPU Usage Over Time",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus-uid" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "max": 100, "min": 0 } },
      "targets": [{ "expr": "process_cpu_usage{application=\"epricing-service\"} * 100", "legendFormat": "JVM CPU %", "refId": "A" }]
    }

  ]
}
