    {
      "id": 22,
      "title": "Pricing Calculation Latency SLA (p50 / p95 / p99)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 15,
        "x": 9,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
