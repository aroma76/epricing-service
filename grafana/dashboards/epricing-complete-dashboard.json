    {
      "id": 2,
      "title": "Service Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "#E02F44",
                  "text": "DOWN"
                },
                "1": {
                  "color": "#9FC119",
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E02F44",
                "value": null
              },
              {
                "color": "#9FC119",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "up{job=\"epricing-service\"}",
          "legendFormat": "Service",
          "refId": "A"
        }
      ]
    },
